{
  "name": "gebaren",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Typ een woord en zie meteen het gebaar in Nederlandse Gebarentaal (NGT).",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-words.ts && vite build",
    "preview": "pnpm build && wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "test:runtime": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/runtime/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:runtime && pnpm test:e2e",
    "smoke": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/smoke.ts",
    "update-index": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/update-index.ts",
    "types": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.160.0"
  }
}
